# Variáveis de ambiente do back-end do Advocondo.
#
# Uso local: copie para .env (cp .env.example .env) e ajuste se precisar.
# O .env é ignorado pelo git e pelo Docker; nunca versione valores reais.
#
# Staging e produção NÃO usam arquivo .env: as variáveis são configuradas
# no painel do Coolify. Veja docs/segredos.md.

# --- Banco de dados (PostgreSQL) -------------------------------------------
# Os valores abaixo são apenas para o Postgres local do docker-compose.
POSTGRES_USER=advocondo
POSTGRES_PASSWORD=advocondo
POSTGRES_DB=advocondo

# URL de conexão usada pela API. No docker-compose ela é montada a partir das
# variáveis acima; fora dele (ex.: uv run fastapi dev), defina aqui.
# Em produção: postgresql+psycopg://<usuario>:<senha>@<host>:5432/<banco>
DATABASE_URL=postgresql+psycopg://advocondo:advocondo@localhost:5432/advocondo

# Banco usado pelos testes de integração. Precisa terminar em "_test": os
# testes apagam e recriam o schema dele. É criado automaticamente se não
# existir. No docker-compose ele é montado automaticamente (host "db").
TEST_DATABASE_URL=postgresql+psycopg://advocondo:advocondo@localhost:5432/advocondo_test

# --- Redefinição de senha e e-mail (ver docs/auth.md) ----------------------
# Endereço do front; o e-mail de redefinição aponta para {FRONTEND_URL}/redefinir-senha.
FRONTEND_URL=http://localhost:3000
# Validade, em minutos, do link de redefinição de senha.
PASSWORD_RESET_LINK_MINUTES=60
# Pedidos de redefinição aceitos por usuário dentro da janela (em minutos); os
# excedentes recebem a mesma resposta, sem e-mail.
PASSWORD_RESET_MAX_REQUESTS=5
PASSWORD_RESET_REQUEST_WINDOW_MINUTES=60
# Servidor SMTP. Vazio só funciona com ENVIRONMENT=local: o e-mail vai para o log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Remetente, obrigatório quando SMTP_HOST está definido.
EMAIL_FROM=

# --- Armazenamento de arquivos (ver docs/documentos.md) ---------------------
# Bucket S3-compatível para os PDFs gerados. Tudo vazio = os arquivos ficam no
# banco (padrão em dev e testes). Para usar o bucket, defina S3_REGION,
# S3_BUCKET, S3_ACCESS_KEY_ID e S3_SECRET_ACCESS_KEY; configuração pela metade
# impede a API de subir.
# Endpoint do serviço: vazio no Amazon S3;
# https://<account-id>.r2.cloudflarestorage.com no Cloudflare R2;
# https://s3.<regiao>.backblazeb2.com no Backblaze B2.
S3_ENDPOINT_URL=
# Região do bucket: ex. sa-east-1 (S3), auto (R2), us-west-004 (B2).
S3_REGION=
S3_BUCKET=
# Chave de acesso com permissão de leitura e escrita só neste bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Observabilidade (ver docs/observabilidade.md) -------------------------
# Nome do ambiente, enviado ao Sentry: local, staging ou producao.
ENVIRONMENT=local
# Versão em execução (ex.: hash do commit). Opcional.
RELEASE=
# DEBUG, INFO, WARNING, ERROR ou CRITICAL.
LOG_LEVEL=INFO
# json (produção) ou console (mais legível no terminal).
LOG_FORMAT=console
# DSN do projeto no Sentry. Vazio = Sentry desligado (padrão em dev e testes).
SENTRY_DSN=
# Fração das requisições com tracing de performance (0.0 a 1.0).
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- HTTPS e CORS (ver docs/https-cors.md) ---------------------------------
# Origens do front liberadas, separadas por vírgula. Nunca use "*".
CORS_ALLOW_ORIGINS=http://localhost:3000
# Regex dos previews da Vercel (só em staging/produção). Vazio = nenhuma.
CORS_ALLOW_ORIGIN_REGEX=
# Mantenha false: a autenticação deve usar o header Authorization.
CORS_ALLOW_CREDENTIALS=false
# Cabeçalho HSTS em segundos. 0 = desligado (dev); 31536000 em produção.
HSTS_MAX_AGE=0

# --- Login (ver docs/auth.md) ----------------------------------------------
# Duração da sessão, em horas, quando o usuário não marca "Manter conectado".
SESSION_DURATION_HOURS=12
# Duração da sessão, em dias, quando o usuário marca "Manter conectado".
REMEMBERED_SESSION_DURATION_DAYS=30

# --- Primeiro Administrador (ver docs/auth.md) -----------------------------
# Token exigido por POST /setup, que cria o primeiro Administrador com o banco
# vazio. Gere com: openssl rand -hex 32 (mínimo de 32 caracteres).
# Vazio = rota desligada. Esvazie depois de criar o Administrador.
SETUP_TOKEN=

INVITE_LINK_MINUTES=1440

# --- Página institucional (ver docs/landing.md) -----------------------------
# Tamanho máximo, em KB, de cada imagem enviada pelo Administrador (ex.: fotos da equipe).
LANDING_IMAGE_MAX_KILOBYTES=2048
