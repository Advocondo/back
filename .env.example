# Variáveis de ambiente do back-end do Advocondo.
#
# Uso local: copie para .env (cp .env.example .env) e ajuste se precisar.
# O .env é ignorado pelo git e pelo Docker; nunca versione valores reais.
#
# Staging e produção NÃO usam arquivo .env: as variáveis são configuradas
# no painel do Coolify. Veja docs/segredos.md.

# --- Banco de dados (PostgreSQL) -------------------------------------------
# Os valores abaixo são apenas para o Postgres local do docker-compose.
POSTGRES_USER=advocondo
POSTGRES_PASSWORD=advocondo
POSTGRES_DB=advocondo

# URL de conexão usada pela API. No docker-compose ela é montada a partir das
# variáveis acima; fora dele (ex.: uv run fastapi dev), defina aqui.
# Em produção: postgresql+psycopg://<usuario>:<senha>@<host>:5432/<banco>
DATABASE_URL=postgresql+psycopg://advocondo:advocondo@localhost:5432/advocondo

# Banco usado pelos testes de integração. Precisa terminar em "_test": os
# testes apagam e recriam o schema dele. É criado automaticamente se não
# existir. No docker-compose ele é montado automaticamente (host "db").
TEST_DATABASE_URL=postgresql+psycopg://advocondo:advocondo@localhost:5432/advocondo_test
